<nav class="flex flex-col p-4 space-y-2 text-sm">
    <NavLink class="text-yellow-800 hover:bg-yellow-200 px-3 py-2 rounded transition-all" activeClass="bg-yellow-300 font-semibold" href="/" Match="NavLinkMatch.All">🏠 Home</NavLink>
    <NavLink class="text-yellow-800 hover:bg-yellow-200 px-3 py-2 rounded transition-all" activeClass="bg-yellow-300 font-semibold" href="inbox">📥 Inbox</NavLink>
    <NavLink class="text-yellow-800 hover:bg-yellow-200 px-3 py-2 rounded transition-all" activeClass="bg-yellow-300 font-semibold" href="lists">📋 Lists</NavLink>
    <NavLink class="text-yellow-800 hover:bg-yellow-200 px-3 py-2 rounded transition-all" activeClass="bg-yellow-300 font-semibold" href="notes">📝 Notes</NavLink>
    <NavLink class="text-yellow-800 hover:bg-yellow-200 px-3 py-2 rounded transition-all" activeClass="bg-yellow-300 font-semibold" href="calendar">📅 Calendar</NavLink>
</nav>

<div class="mt-auto pt-4 border-t border-yellow-300">
    <button class="w-full text-left text-red-600 hover:text-red-800 px-3 py-2 rounded transition-all"
            @onclick="Logout">
        🚪 Sign out
    </button>
</div>

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

@code {
    private async Task Logout()
    {
        var request = new HttpRequestMessage(HttpMethod.Post, "/api/auth/logout");
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        await Http.SendAsync(request);
        Nav.NavigateTo("/auth", forceLoad: true);
        await JS.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "false");

    }
}
