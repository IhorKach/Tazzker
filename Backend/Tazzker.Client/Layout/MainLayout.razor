@inherits LayoutComponentBase
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IndexedDbBridge Db

<div class="flex h-screen">
    <!-- Sidebar -->
    @if (isNavOpen)
    {
        <div class="w-64 bg-gray-900 text-white">
            <NavMenu />
        </div>
    }

    <!-- Контент и бургер -->
    <div class="flex-1 flex flex-col">
        <!-- Верхняя панель -->
        <div class="bg-gray-800 text-white flex justify-between items-center px-4 py-2 shadow">
            <h1 class="text-xl font-bold">Tazzker</h1>
            <button class="text-2xl text-left" @onclick="ToggleNav">☰</button>
            <button class="text-sm text-red-300 hover:text-white ml-4"
                    @onclick="Logout">
                🚪 Выйти
            </button>

        </div>

        <!-- Контент -->
        <main class="px-4 pt-0 overflow-auto flex-1 bg-gray-50 h-full">
            @Body
        </main>
    </div>
</div>

<!-- 🟡 ИНДИКАТОР СИНХРОНИЗАЦИИ: вынесен за пределы основного layout -->
@if (!Nav.Uri.Contains("/auth")) // добавить в это поле все страницы где его не должно быть.
{
    <Tazzker.Client.Components.SyncIndicator/>
}
<Tazzker.Client.Components.AutoSyncService />

@code {
    private bool isNavOpen = true;
    private void ToggleNav() => isNavOpen = !isNavOpen;

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        foreach (var store in new[] { "Tasks", "Notes", "Lists", "Sublists" })
        {
            await Db.ClearAsync(store);
        }
        Nav.NavigateTo("/auth", forceLoad: true);
    }
}