@inherits LayoutComponentBase
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IndexedDbBridge Db
@inject HttpClient Http

<div class="relative h-screen overflow-hidden bg-yellow-50">
    
    <div class="fixed top-0 left-0 h-full z-40 transition-transform duration-200 transform bg-yellow-100 text-yellow-900 w-64 shadow-md"
         style="@(isNavOpen ? "transform: translateX(0%)" : "transform: translateX(-100%)")">
        <div class="p-4 border-b border-yellow-300 flex justify-between items-center">
            <h2 class="text-lg font-semibold">Menu</h2>
            <button class="text-yellow-800 text-xl" @onclick="ToggleNav">✕</button>
        </div>
        <NavMenu />
    </div>

    <div class="flex flex-col h-full ml-0">

        <div class="bg-yellow-200 text-yellow-900 px-4 py-2 shadow z-10 relative">

            <button class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl font-bold z-20" @onclick="ToggleNav">☰</button>

            <div class="flex items-center justify-center">
                <img src="logo.png"
                     alt="Tazzker Logo"
                     style="height: 40px; width: auto; object-fit: contain;" />
            </div>
        </div>


        <main class="flex-1 overflow-auto px-4 pt-2 bg-yellow-50">
            @Body
        </main>
    </div>
</div>

@if (!Nav.Uri.Contains("/auth"))
{
    <Tazzker.Client.Components.SyncIndicator />
}
<Tazzker.Client.Components.AutoSyncService />

@code {
    private bool isNavOpen = false;

    private void ToggleNav() => isNavOpen = !isNavOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        isNavOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

}
