@*
@using Tazzker.Client.Components;
@page "/list/{Id}"
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@inject ILocalDb<ListModel> ListDb
@inject ILocalDb<SublistModel> SublistDb
@inject ILocalDb<TaskModel> TaskDb
@inject NavigationManager Nav

<h2 class="text-3xl font-bold text-yellow-800 sticky top-0 z-20 bg-yellow-50 px-4 py-4 shadow flex justify-between items-center">
    <span>📂 @list?.Title</span>
    <span class="text-sm text-yellow-600">@list?.UpdatedAt.ToLocalTime().ToString("g")</span>
</h2>

<!-- Кнопка добавления подсписка -->
<div class="px-4 mb-4">
    <button @onclick="AddSublist"
            class="bg-yellow-400 hover:bg-yellow-500 text-white px-4 py-2 rounded shadow">
        ➕ Добавить подсписок
    </button>
</div>

<!-- Обёртка подсписков -->
<div class="flex overflow-x-auto gap-4 px-4 pb-8 snap-x sm:flex-wrap">
    @foreach (var sub in sublists)
    {
        <div class="min-w-[300px] bg-white rounded-xl shadow p-4 flex-shrink-0 snap-start sm:w-full">
            <div class="flex justify-between items-center mb-3">
                <input type="text"
                       @bind="sub.Title"
                       @onblur="() => SaveSublist(sub)"
                       class="w-full font-semibold text-lg border-b border-gray-300 focus:outline-none focus:border-yellow-500" />

                <button @onclick="() => AddTask(sub.Id)"
                        class="ml-2 text-yellow-600 hover:text-yellow-800 text-lg">
                    ➕
                </button>
            </div>

            <ul class="space-y-2">
                @if (tasksBySublist.TryGetValue(sub.Id, out var taskList))
                {
                    @foreach (var task in taskList)
                    {
                        <li class="flex items-center bg-yellow-50 rounded p-2 shadow-sm">
                            <input type="checkbox"
                                   @bind="task.IsCompleted"
                                   @bind:after="() => SaveTask(task)"
                                   class="mr-2" />

                            <span class="flex-grow cursor-pointer" @onclick="() => selectedTask = task">
                                @task.Title
                            </span>

                            <button @onclick="() => DeleteTask(task.Id)"
                                    @onclick:stopPropagation
                                    class="ml-2 text-red-500 hover:text-red-700">✕</button>
                        </li>
                    }
                }
            </ul>

            <button @onclick="() => AddTask(sub.Id)"
                    class="mt-3 bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-1 rounded shadow w-full">
                ➕ Добавить задачу
            </button>
        </div>
    }
</div>

<!-- TaskPanel модалка -->
<TaskPanel Task="selectedTask"
           OnSave="SaveTask"
           Close="@(() => selectedTask = null)" />

<!-- Назад -->
<div class="px-4">
        @{
        var url = "/lists";
    }
    <button @onclick="() => Nav.NavigateTo(url)"
            class="mt-6 underline text-yellow-700">
        ← Назад ко всем спискам
    </button>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    ListModel? list;
    List<SublistModel> sublists = new();
    Dictionary<string, List<TaskModel>> tasksBySublist = new();
    TaskModel? selectedTask;

    protected override async Task OnInitializedAsync()
    {
        list = await ListDb.GetByIdAsync(Id);
        var allSublists = await SublistDb.GetAllAsync();
        sublists = allSublists.Where(s => s.ListId == Id).OrderBy(s => s.Order).ToList();

        if (sublists.Count == 0)
        {
            await AddSublist();
        }
        else
        {
            await LoadTasks();
        }
    }

    async Task LoadTasks()
    {
        var allTasks = await TaskDb.GetAllAsync();
        tasksBySublist = sublists.ToDictionary(
            s => s.Id,
            s => allTasks.Where(t => t.SublistId == s.Id).OrderBy(t => t.Order).ToList()
        );
    }

    async Task AddSublist()
    {
        var sub = new SublistModel
        {
            ListId = Id,
            Title = "Новый подсписок",
            Order = sublists.Count + 1
        };
        await SublistDb.AddOrUpdateAsync(sub);
        sublists = await SublistDb.GetAllAsync().ContinueWith(t => t.Result.Where(s => s.ListId == Id).OrderBy(s => s.Order).ToList());
        await LoadTasks();
    }

    async Task SaveSublist(SublistModel sub) => await SublistDb.AddOrUpdateAsync(sub);
    async Task AddTask(string sublistId)
    {
        var task = new TaskModel
        {
            SublistId = sublistId,
            Title = "Новая задача",
            Description = "",
            Order = tasksBySublist.ContainsKey(sublistId) ? tasksBySublist[sublistId].Count + 1 : 1
        };
        await TaskDb.AddOrUpdateAsync(task);
        await LoadTasks();
    }

    async Task SaveTask(TaskModel task) => await TaskDb.AddOrUpdateAsync(task);

    async Task DeleteTask(string id)
    {
        await TaskDb.SoftDeleteAsync(id);
        await LoadTasks();
    }
}

