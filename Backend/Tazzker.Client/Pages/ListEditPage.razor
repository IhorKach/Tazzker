 @page "/list/{Id:guid}"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject ModelMethods App
@inject IJSRuntime JS
@inject SyncService SyncServ

@if (list != null)
{
	<!-- Navigation -->
	<div class="p-4 mb-4 bg-yellow-50 border-b justify-between flex items-center gap-4 shadow-sm sticky top-0 z-20">
		@{
			var backLabel = "< Back";
		}
		<button @onclick="GoBack"
				class="text-yellow-600  hover:text-yellow-800 font-semibold text-sm">
			@backLabel
		</button>
		<span class="text-xs text-gray-400 italic">
			Last updated: @GetLastUpdate().ToLocalTime().ToString("g")
		</span>
	</div>

	<!-- Title -->
	<div class="px-4 py-3 bg-yellow-50 border-b border-yellow-200 flex flex-col items-center gap-1 shadow-sm">

		<!-- List title textarea -->
		<textarea maxlength="@TitleMaxLength"
				  class="text-xl font-bold text-yellow-800 bg-transparent border-b border-yellow-400 focus:outline-none text-center w-full max-w-xs break-words px-2 py-1 rounded resize-none overflow-hidden"
				  rows="1"
				  value="@list.Title"
				  @oninput="HandleTitleInput"
				  @onblur="() => SaveList(list)">
	</textarea>

		<!-- Counter -->
		<div class="text-xs text-gray-500">@list.Title.Length / @TitleMaxLength</div>
	</div>


	<!-- Page container -->
	<div class="flex flex-col gap-4 px-4 py-6 max-w-screen-xl mx-auto">

		@foreach (var sub in sublists)
		{

			<div class="bg-white border border-yellow-300 rounded-xl shadow p-4 flex flex-col gap-3 w-full">
				<!-- Title + delete button -->
				<div class="flex items-center justify-between gap-2 mb-2">

					<textarea maxlength="128"
							  class="text-lg font-semibold border-b w-full focus:outline-none focus:border-yellow-500 resize-none overflow-hidden leading-snug"
							  rows="1"
							  @bind="sub.Title"
							  @oninput="Resize"
							  @onblur="() => SaveSublist(sub)">
										</textarea>
					<AutoResizeMarker></AutoResizeMarker>

					<button class="text-red-500 hover:text-red-700 text-lg font-bold px-2"
							@onclick="() =>{ showConfirmModal =true; sublistToDelete = sub.Id;}">
						Х
					</button>

				</div>

				@if (tasksBySublist.TryGetValue(sub.Id, out var subTasks))
				{
					<div class="flex flex-col gap-2 w-full">
						@foreach (var task in subTasks)
						{
							<div class="w-full">
								<TaskCard TaskItem="task" OnChanged="async ()=>{await SaveTask(task); await RefreshTasks(); }" />
							</div>
						}
					</div>
				}

				<button @onclick="() => AddTask(sub.Id)"
						class="self-start mt-2 w-9 h-9 flex items-center justify-center rounded-full bg-yellow-400 hover:bg-yellow-500 text-white text-xl font-bold shadow transition">
					+
				</button>
			</div>

		}
		
		<button @onclick="AddSublist"
				class="w-12 h-12 flex items-center justify-center rounded-full bg-yellow-400 hover:bg-yellow-500 text-white text-2xl shadow mx-auto mt-4 font-bold transition">
			+
		</button>
	</div>
}

<ConfirmDialog Message="Delete the sublist along with all its tasks?"
			   Show="@showConfirmModal"
			   OnConfirm="HandleConfirmDelete" />



@code {
	[Parameter] public Guid Id { get; set; }
	private ListModel list = new();

	private int TitleMaxLength = 128;
	private bool showConfirmModal = false;
	private Guid? sublistToDelete = null;


	List<SublistModel> sublists = new();
	Dictionary<Guid, List<TaskModel>> tasksBySublist = new();

	private async Task HandleConfirmDelete(bool confirmed)
	{
		showConfirmModal = false;

		if (!confirmed || sublistToDelete is null) return;

		if (tasksBySublist.TryGetValue((Guid)sublistToDelete, out var subTasks))
		{
			foreach (var task in subTasks)
				await App.DeleteTask(task.Id);
		}

		await App.DeleteSublist((Guid)sublistToDelete);

		showConfirmModal = false;
		sublistToDelete = null;

		await RefreshTasks();
		await RefreshSublists();
	}


	private async Task HandleTitleInput(ChangeEventArgs e)
	{
		list.Title = e.Value?.ToString() ?? "";
		await JS.InvokeVoidAsync("resizeTextareas");
	}


	private DateTime GetLastUpdate()
	{
		var listUpdated = list.UpdatedAt;

		var sublistUpdated = sublists
			.Select(s => s.UpdatedAt);

		var taskUpdated = tasksBySublist
			.SelectMany(kvp => kvp.Value)
			.Select(t => t.UpdatedAt);

		return new[] { listUpdated }
			.Concat(sublistUpdated)
			.Concat(taskUpdated)
			.Max();
	}

	private void GoBack() => Nav.NavigateTo("/lists");

	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += RefreshSublists;
		SyncServ.OnSynced += RefreshTasks;


		var found = await App.GetListById(Id);
		list = found ?? new ListModel { Id = Id, Title = "" };


		await RefreshSublists();

		await RefreshTasks();

		if (sublists.Count == 0) await AddSublist();
	}

	private async Task RefreshTasks()
	{
		var allTasks = await App.GetAllTasks();

		tasksBySublist = sublists.ToDictionary(
			s => s.Id,
			s => allTasks.Where(t => t.SublistId == s.Id).OrderBy(t => t.IsCompleted).ThenBy(t=>t.Order).ToList()
		);
	}
	private async Task RefreshSublists()
	{
		var allSublists = await App.GetAllSublists();

		sublists = allSublists.Where(s => s.ListId == Id)
		.OrderBy(s => s.Order)
		.ToList();
	}

	private async Task AddSublist()
	{
		await App.AddSublist(Id);
		await RefreshSublists();
	}

	private async Task DeleteSublist(Guid sublistId)
	{
		await App.DeleteSublist(sublistId);
		await RefreshSublists();
	}

	private async Task SaveSublist(SublistModel sublist)
	{
		await App.SaveSublist(sublist);
	}
	private async Task SaveList(ListModel list)
	{
		await App.SaveList(list);
	}

	private async Task AddTask(Guid sublistId)
	{
		await App.AddTask(sublistId);
		await RefreshTasks();
	}

	private async Task DeleteTask(Guid taskId)
	{
		await App.DeleteTask(taskId);
		await RefreshTasks();
	}

	private async Task SaveTask(TaskModel task)
	{
		await App.SaveTask(task);
	}

	private async Task Resize(ChangeEventArgs _)
	{
		await JS.InvokeVoidAsync("resizeTextareas");
	}
}