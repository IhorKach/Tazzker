@code {
	[Parameter] public Guid Id { get; set; }

	ListModel? list;
	List<SublistModel> sublists = new();
	Dictionary<Guid, List<TaskModel>> tasksBySublist = new();
	Dictionary<Guid, ElementReference> sublistInputs = new();
	TaskModel? selectedTask;

	protected override async Task OnInitializedAsync()
	{
		list = await ListDb.GetByIdAsync(Id);
		var allSublists = await SublistDb.GetAllAsync();
		sublists = allSublists.Where(s => s.ListId == Id).OrderBy(s => s.Order).ToList();

		foreach (var s in sublists)
			sublistInputs[s.Id] = default;

		if (sublists.Count == 0)
		{
			await AddSublist();
		}
		else
		{
			await LoadTasks();
		}
	}

	async Task LoadTasks()
	{
		var allTasks = await TaskDb.GetAllAsync();
		tasksBySublist = sublists.ToDictionary(
			s => s.Id,
			s => allTasks
				.Where(t => t.SublistId.HasValue && t.SublistId.Value == s.Id)
				.OrderBy(t => t.Order)
				.ToList()
			);

	}

	async Task AddSublist()
	{
		var sub = new SublistModel
			{
				Id = Guid.NewGuid(),
				ListId = Id,
				Title = "Новый подсписок",
				Order = sublists.Count + 1
			};

		await SublistDb.AddOrUpdateAsync(sub);
		sublists = await SublistDb.GetAllAsync().ContinueWith(t => t.Result
			.Where(s => s.ListId == Id)
			.OrderBy(s => s.Order)
			.ToList());

		foreach (var s in sublists)
			sublistInputs[s.Id] = default;

		await LoadTasks();
	}

	async Task SaveSublist(SublistModel sub) => await SublistDb.AddOrUpdateAsync(sub);

	async Task AddTask(Guid sublistId)
	{
		var task = new TaskModel
			{
				SublistId = sublistId,
				Title = "Новая задача",
				Description = "",
				Order = tasksBySublist.ContainsKey(sublistId) ? tasksBySublist[sublistId].Count + 1 : 1
			};
		await TaskDb.AddOrUpdateAsync(task);
		await LoadTasks();
	}

	async Task SaveTask(TaskModel task) => await TaskDb.AddOrUpdateAsync(task);

	async Task DeleteTask(Guid id)
	{
		await TaskDb.SoftDeleteAsync(id);
		await LoadTasks();
	}

	async Task FocusToEnd(Guid sublistId)
	{
		if (sublistInputs.TryGetValue(sublistId, out var input))
		{
			await JS.InvokeVoidAsync("selectToEnd", input);
		}
	}
} *@
