		</button>
	</div>


}

<TaskPanel Task="selectedTask"
		   OnSave="SaveTask"
		   Close="@(() => selectedTask = null)" />





<button @onclick="() => Nav.NavigateTo(backUrl)" class="mt-6 underline">← Назад ко всем спискам</button>

@code {

	string backUrl => "/lists";

	TaskModel? selectedTask;

	[Parameter]
	public string Id { get; set; } = "";

	ListModel? list;
	List<SublistModel> sublists = new();
	Dictionary<string, List<TaskModel>> tasksBySublist = new();

	protected override async Task OnInitializedAsync()
	{
		list = await ListDb.GetByIdAsync(Id);
		await LoadSublists();
	}

	async Task LoadSublists()
	{
		var all = await SublistDb.GetAllAsync();
		sublists = all.Where(x => x.ListId == Id).OrderBy(x => x.Order).ToList();
		await LoadTasks();
	}

	async Task LoadTasks()
	{
		var allTasks = await TaskDb.GetAllAsync();
		tasksBySublist = sublists.ToDictionary(
			s => s.Id,
			s => allTasks.Where(t => t.SublistId == s.Id).OrderBy(t => t.Order).ToList()
		);
	}

	async Task AddSublist()
	{
		var sub = new SublistModel
			{
				ListId = Id,
				Title = "Новый подсписок",
				Order = sublists.Count + 1
			};

		await SublistDb.AddOrUpdateAsync(sub);
		await LoadSublists();
	}

	async Task Save(SublistModel sub)
	{
		await SublistDb.AddOrUpdateAsync(sub);
	}

	async Task AddTask(string sublistId)
	{
		var task = new TaskModel
			{
				SublistId = sublistId,
				Title = "Новая задача",
				Description = "",
				Order = tasksBySublist[sublistId]?.Count + 1 ?? 1
			};

		await TaskDb.AddOrUpdateAsync(task);
		await LoadTasks();
	}

	async Task SaveTask(TaskModel task)
	{
		await TaskDb.AddOrUpdateAsync(task);
	}

	async Task DeleteTask(string id)
	{
		await TaskDb.SoftDeleteAsync(id);
		await LoadTasks();
	}
}

    @{
        var url = "/lists";
    }
