<h2 class="text-xl font-bold mb-4">📂 @list?.Title</h2>

<button @onclick="AddSublist" class="bg-blue-500 text-white px-3 py-2 rounded">Добавить подсписок</button>

@foreach (var sub in sublists)
{
	<div class="bg-gray-100 p-4 rounded mb-4">
