@page "/notes"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject ModelMethods App
@inject SyncService SyncServ


<h2 class="text-2xl font-bold mb-4 text-yellow-800 sticky top-0 bg-yellow-50 py-4 z-20">
	📒 Заметки
</h2>

@if (notes.Count == 0)
{
	<div class="text-center text-gray-400 italic mt-8">Нет заметок. Добавьте первую заметку 🐝</div>
}
else
{
	<div class="grid gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
		@foreach (var note in notes)
		{
			<NoteCard NoteItem="note" OnClick="Redirect" OnDelete="SetNoteToDelete"></NoteCard>
		}
	</div>
}
<StickyAddButton OnClick="AddNote"></StickyAddButton>

<ConfirmDialog Message="Удалить заметку?"
			   Show="@showConfirmModal"
			   OnConfirm="HandleConfirmDelete" />


@code {
	List<NoteModel> notes = new();


	private bool showConfirmModal = false;
	private Guid? noteToDelete = null;

	private void SetNoteToDelete(Guid noteId)
	{
		noteToDelete = noteId;
		showConfirmModal =true;
	}


	private async Task HandleConfirmDelete(bool confirmed)
	{
		showConfirmModal = false;

		if (!confirmed || noteToDelete is null) return;

		await DeleteNote((Guid)noteToDelete);

	}


	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += Refresh;
		await Refresh();
	}

	private async Task AddNote()
	{
		var noteId = await App.AddNote();
		Redirect(noteId);

	}

	private async Task DeleteNote(Guid id)
	{
		await App.DeleteNote(id);
		await Refresh();
	}

	private async Task Refresh() => notes = await App.GetAllNotes();


	private void Redirect(Guid noteId) => Nav.NavigateTo($"/note/{noteId}");

}
