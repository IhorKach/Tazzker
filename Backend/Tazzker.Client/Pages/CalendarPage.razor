 @page "/calendar"
 @using Tazzker.Client.Components
 @using Tazzker.Client.Services
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@using System.Globalization
@inject ModelMethods App
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SyncService SyncServ


<h2 class="text-3xl font-bold text-yellow-800 sticky top-0 z-20 bg-yellow-50 px-4 py-4 shadow">
	📅 Calendar
</h2>
<!-- Trick for Tailwind purge -->
<div class="hidden border-yellow-500 border-2 rounded"></div>

<div class="px-4 py-6 space-y-4">
	<!-- Навигация по месяцам и годам -->
	@{
		var prevLabel = "<";
		var nextLabel = ">";
	}
	<div class="flex items-center justify-between px-4 py-2 bg-yellow-50 rounded-xl shadow-sm border border-yellow-200 mb-4">
		<!-- Кнопка "Назад" -->
		<button @onclick="() => ChangeMonth(-1)"
				class="text-yellow-600 hover:text-yellow-800 text-xl sm:text-2xl font-bold px-3 py-1 transition-colors rounded hover:bg-yellow-100">
			@prevLabel
		</button>

		<!-- Селекторы месяца и года -->
		<div class="flex items-center gap-2 sm:gap-4">
			<select @bind="selectedMonth"
					@bind:after="OnMonthChanged"
					class="bg-white text-yellow-800 border border-yellow-300 rounded-lg px-3 py-1 shadow-sm focus:outline-none focus:ring-2 focus:ring-yellow-400 transition-all">
				@for (int m = 1; m <= 12; m++)
				{
					<option value="@m">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
				}
			</select>

			<select @bind="selectedYear"
					@bind:after="OnYearChanged"
					class="bg-white text-yellow-800 border border-yellow-300 rounded-lg px-3 py-1 shadow-sm focus:outline-none focus:ring-2 focus:ring-yellow-400 transition-all">
				@for (int y = currentYear - 5; y <= currentYear + 5; y++)
				{
					<option value="@y">@y</option>
				}
			</select>
		</div>

		<!-- Кнопка "Вперёд" -->
		<button @onclick="() => ChangeMonth(1)"
				class="text-yellow-600 hover:text-yellow-800 text-xl sm:text-2xl font-bold px-3 py-1 transition-colors rounded hover:bg-yellow-100">
			@nextLabel
		</button>
	</div>

	<!-- Сетка дней недели -->
	<div class="grid grid-cols-7 text-center font-semibold text-yellow-700">
	@* 	<div>Пн</div><div>Вт</div><div>Ср</div><div>Чт</div><div>Пт</div><div>Сб</div><div>Вс</div> *@
		<div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
	</div>

	<!-- Сетка дней месяца -->
	<div class="grid grid-cols-7 divide-x divide-y divide-yellow-100 border border-yellow-200">
		@foreach (var day in visibleDays)
		{
			var isToday = day.Date.Date == DateTime.Today;
			var hasTasks = taskMap.ContainsKey(day.Date.Date);

			<div class=@($"p-2 sm:p-3 text-sm cursor-pointer transition-all duration-200 {(day.IsCurrentMonth ? "bg-white" : "bg-yellow-50 text-gray-400")} {(isToday ? "bg-yellow-100 border-2 border-yellow-800 font-bold shadow-inner" : "")}")
				 @onclick="() => SelectDay(day.Date)">


				<div class="flex items-center justify-between">
					<span class="font-semibold">@day.Date.Day</span>
					@if (hasTasks)
					{
						<span class="w-2 h-2 rounded-full bg-yellow-500"></span>
					}
				</div>
			</div>
		}
	</div>
</div>



@code {
	private DateTime currentMonth = DateTime.Today;
	private List<CalendarDay> visibleDays = new();
	private Dictionary<DateTime, List<TaskModel>> taskMap = new();

	private int selectedMonth;
	private int selectedYear;
	private int currentYear = DateTime.Today.Year;

	private void SelectDay(DateTime day) => Nav.NavigateTo($"/calendar/{day:yyyy-MM-dd}");

	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += LoadCalendar;
		selectedMonth = currentMonth.Month;
		selectedYear = currentMonth.Year;
		await LoadCalendar();
	}

	private async Task LoadCalendar()
	{
		var allTasks = await App.GetAllTasks();

		taskMap = allTasks
			.Where(t => t.DueTime.HasValue && !t.PermDeleted/* IsDeleted */)
			.GroupBy(t => t.DueTime!.Value.Date)
			.ToDictionary(g => g.Key, g => g.ToList());

		visibleDays = GetVisibleDays(currentMonth);
	}

	private void ChangeMonth(int offset)
	{
		currentMonth = currentMonth.AddMonths(offset);
		selectedMonth = currentMonth.Month;
		selectedYear = currentMonth.Year;
		visibleDays = GetVisibleDays(currentMonth);
	}


	private List<CalendarDay> GetVisibleDays(DateTime month)
	{
		var firstDay = new DateTime(month.Year, month.Month, 1);
		var startOfWeek = firstDay.AddDays(-(int)(firstDay.DayOfWeek == 0 ? 6 : (int)firstDay.DayOfWeek - 1));
		var days = new List<CalendarDay>();
		for (int i = 0; i < 42; i++)
		{
			var date = startOfWeek.AddDays(i);
			days.Add(new CalendarDay
				{
					Date = date,
					IsCurrentMonth = date.Month == month.Month
				});
		}
		return days;
	}

	private async Task OnMonthChanged()
	{
		await UpdateCalendarFromSelection();
	}

	private async Task OnYearChanged()
	{
		await UpdateCalendarFromSelection();
	}

	private async Task UpdateCalendarFromSelection()
	{
		currentMonth = new DateTime(selectedYear, selectedMonth, 1);
		visibleDays = GetVisibleDays(currentMonth);
		await InvokeAsync(StateHasChanged);
	}

	class CalendarDay
	{
		public DateTime Date { get; set; }
		public bool IsCurrentMonth { get; set; }
	}
}
