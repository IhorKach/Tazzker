@page "/auth"
@using System.Net.Http.Json
@using Tazzker.Client.Services
@using Tazzker.Client.Data.Models

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SyncService SyncService

<h2 class="text-2xl font-bold mb-6 text-yellow-800 text-center">🐝 Добро пожаловать в Tazzker</h2>

<!-- Переключатели Войти / Зарегистрироваться -->
<div class="flex justify-center space-x-4">
    <button @onclick="() => isLogin = true"
            class=@($"px-4 py-2 rounded font-semibold transition-all {(isLogin ? "bg-yellow-400 text-white" : "bg-yellow-100 text-yellow-700")}")>
        Войти
    </button>
    <button @onclick="() => isLogin = false"
            class=@($"px-4 py-2 rounded font-semibold transition-all {(!isLogin ? "bg-yellow-400 text-white" : "bg-yellow-100 text-yellow-700")}")>
        Зарегистрироваться
    </button>
</div>

<!-- Форма -->
<div class="mt-6 max-w-sm mx-auto bg-white p-6 rounded shadow space-y-4">
    @if (!isLogin)
    {
        <InputText @bind-Value="Email" class="w-full border p-2 rounded" placeholder="Email" />
        <InputText @bind-Value="Username" class="w-full border p-2 rounded" placeholder="Имя пользователя" />
    }
    else
    {
        <InputText @bind-Value="Username" class="w-full border p-2 rounded" placeholder="Имя пользователя или Email" />
    }
    <InputText @bind-Value="Password" class="w-full border p-2 rounded" placeholder="Пароль" />
    <InputText @bind-Value="ConfirmPassword" class="w-full border p-2 rounded" placeholder="Подтвердите пароль" />

    <button @onclick="Submit"
            class="w-full bg-yellow-400 hover:bg-yellow-500 text-white py-2 rounded">
        @(isLogin ? "Войти" : "Зарегистрироваться")
    </button>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="text-red-600 text-sm text-center">@Error</div>
    }
</div>

@code {
    private bool isLogin = true;
    private string Email = "";
    private string Username = "";
    private string Password = "";
    private string ConfirmPassword = "";
    private string Error = "";


    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/lists");
        }
    }


    private async Task Submit()
    {
        Error = "";

        if (!isLogin && Password != ConfirmPassword)
        {
            Error = "Пароли не совпадают.";
            return;
        }

        object payload = isLogin
            ? new { Username, Password }
            : new { Email, Username, Password };

        var url = isLogin ? "/api/auth/login" : "/api/auth/register";

        try
        {
            var response = await Http.PostAsJsonAsync(url, payload);
            if (response.IsSuccessStatusCode)
            {
                // Читаем как объект, а не просто строку
                var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (authResponse == null)
                {
                    Error = "Ошибка получения токенов.";
                    return;
                }

                // 1. Парсим новый UserId из accessToken
                var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
                var token = handler.ReadJwtToken(authResponse.AccessToken);
                var extractedUserId = token.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                if (string.IsNullOrWhiteSpace(extractedUserId))
                {
                    Error = "Ошибка в токене.";
                    return;
                }

                // 2. Получаем текущий сохранённый UserId из localStorage
                var storedUserId = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserId");

                // 3. Если UserId поменялся — чистим IndexedDB
                if (storedUserId != null && storedUserId != extractedUserId)
                {
                    await SyncService.ClearAllAsync(); // Добавим этот метод чуть позже
                }

                // 4. Сохраняем новый токен и refresh токен
                await JS.InvokeVoidAsync("localStorage.setItem", "authToken", authResponse.AccessToken);
                await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", authResponse.RefreshToken);

                // 5. Сохраняем новый UserId
                await JS.InvokeVoidAsync("localStorage.setItem", "currentUserId", extractedUserId);

                // 6. Подтягиваем свежие данные
                await SyncService.PullAllAsync();

                // ✅ Уходим на списки
                Nav.NavigateTo("/lists");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Error = error;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Error = "Ошибка соединения с сервером.";
        }
    }

}

