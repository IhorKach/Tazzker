@page "/auth"
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using Tazzker.Client.Services
@using Tazzker.Client.Data.Models

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SyncService SyncService


<!-- Переключатели Войти / Зарегистрироваться -->
<div class="flex justify-center space-x-4 mt-6">
	<button @onclick="() => isLogin = true"
			class=@($"px-4 py-2 rounded font-semibold transition-all {(isLogin ? "bg-yellow-400 text-white" : "bg-yellow-100 text-yellow-700")}")>
		Sign in
	</button>
	<button @onclick="() => isLogin = false"
			class=@($"px-4 py-2 rounded font-semibold transition-all {(!isLogin ? "bg-yellow-400 text-white" : "bg-yellow-100 text-yellow-700")}")>
		Sign up
	</button>
</div>

<!-- Форма -->
<div class="mt-6 max-w-sm mx-auto bg-white p-6 rounded shadow space-y-4">

	<input type="text"
		   maxlength="32"
		   class="w-full border p-2 rounded"
		   placeholder="Username"
		   value="@Username"
		   @oninput="OnUsernameChanged" />

	<input type="password"
		   maxlength="32"
		   class="w-full border p-2 rounded"
		   placeholder="Password"
		   value="@Password"
		   @oninput="OnPasswordChanged" />

	<button @onclick="Submit"
			class="w-full bg-yellow-400 hover:bg-yellow-500 text-white py-2 rounded">
		@(isLogin ? "Sign In" : "Sign up")
	</button>

	@if (!string.IsNullOrWhiteSpace(Error) && (!string.IsNullOrEmpty(Username) || !string.IsNullOrEmpty(Password)))
	{
		<div class="text-red-600 text-sm text-center">@Error</div>
	}

</div>

@code {
	private bool isLogin = true;
	private string Username = "";
	private string Password = "";

	private string Error = "";


	private void OnUsernameChanged(ChangeEventArgs e)
	{
		Username = e.Value?.ToString() ?? "";
		ValidateInputs();
	}

	private void OnPasswordChanged(ChangeEventArgs e)
	{
		Password = e.Value?.ToString() ?? "";
		ValidateInputs();
	}


	private void ValidateInputs()
	{
		if (string.IsNullOrWhiteSpace(Username))
		{
			Error = "Username cannot be empty.";
			StateHasChanged();
			return;
		}

		if (Username.Any(char.IsWhiteSpace))
		{
			Error = "Username cannot contain spaces.";
			StateHasChanged();
			return;
		}

		if (!Regex.IsMatch(Username, "^[a-zA-Z0-9_]+$"))
		{
			Error = "Only letters, numbers, and underscores are allowed.";
			StateHasChanged();
			return;
		}

		if (Username.Length < 3)
		{
			Error = "Username must be at least 3 characters.";
			StateHasChanged();
			return;
		}

		if (Password.Length < 6)
		{
			Error = "Password must be at least 6 characters.";
			StateHasChanged();
			return;
		}

		Error = ""; // всё валидно — убираем ошибку
		StateHasChanged();
	}



	private async Task Submit()
	{

		ValidateInputs();
		if (!string.IsNullOrWhiteSpace(Error)) return;

		Error = "";


		if (!await JS.InvokeAsync<bool>("isOnline"))
		{
			Error = "No internet connection.";
			return;
		}

		object payload = isLogin
			? new { Username, Password }
			: new { Username, Password };

		var url = isLogin ? "/api/auth/login" : "/api/auth/register";

		try
		{
			var request = new HttpRequestMessage(HttpMethod.Post, url)
				{
					Content = JsonContent.Create(payload)
				};
			request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

			var response = await Http.SendAsync(request);
			if (!response.IsSuccessStatusCode)
			{
				Error = await response.Content.ReadAsStringAsync();
				return;
			}

			// Получаем userId
			var userIdRequest = new HttpRequestMessage(HttpMethod.Get, "/api/auth/userid");
			userIdRequest.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
			var userIdResponse = await Http.SendAsync(userIdRequest);

			if (!userIdResponse.IsSuccessStatusCode)
			{
				Error = "Failed to obtain user ID.";
				return;
			}

			var newUserId = await userIdResponse.Content.ReadAsStringAsync();
			var storedUserId = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserId");

			if (string.IsNullOrWhiteSpace(storedUserId) || !isLogin)
			{
				// Первая авторизация
				await JS.InvokeVoidAsync("localStorage.setItem", "currentUserId", newUserId);
				await SyncService.PullAllAsync();
			}
			else if (storedUserId != newUserId)
			{
				// Новый аккаунт
				await SyncService.ClearAllAsync();
				await JS.InvokeVoidAsync("localStorage.setItem", "currentUserId", newUserId);
				await SyncService.PullAllAsync();
			}
			else
			{
				// Тот же аккаунт
				await SyncService.SyncAllAsync();
				await SyncService.PullAllAsync();
			}

			// Отмечаем, что пользователь залогинен
			await JS.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "true");

			Nav.NavigateTo("/lists");
		}
		catch (Exception ex)
		{
			Console.WriteLine(ex);
			Error = "Server connection error.";
		}
	}

}