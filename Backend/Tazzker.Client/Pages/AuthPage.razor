@*
    @code {
    private bool isLogin = true;
    private string Email = "";
    private string Username = "";
    private string Password = "";
    private string ConfirmPassword = "";
    private string Error = "";


    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (!string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/lists");
        }
    }


    private async Task Submit()
    {
        Error = "";

        if (!isLogin && Password != ConfirmPassword)
        {
            Error = "Пароли не совпадают.";
            return;
        }

        object payload = isLogin
            ? new { Username, Password }
            : new { Email, Username, Password };

        var url = isLogin ? "/api/auth/login" : "/api/auth/register";

        try
        {
            var response = await Http.PostAsJsonAsync(url, payload);
            if (response.IsSuccessStatusCode)
            {
                // Читаем как объект, а не просто строку
                var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (authResponse == null)
                {
                    Error = "Ошибка получения токенов.";
                    return;
                }

                // 1. Парсим новый UserId из accessToken
                var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
                var token = handler.ReadJwtToken(authResponse.AccessToken);
                var extractedUserId = token.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                if (string.IsNullOrWhiteSpace(extractedUserId))
                {
                    Error = "Ошибка в токене.";
                    return;
                }

                // 2. Получаем текущий сохранённый UserId из localStorage
                var storedUserId = await JS.InvokeAsync<string>("localStorage.getItem", "currentUserId");

                // 3. Если UserId поменялся — чистим IndexedDB
                if (storedUserId != null && storedUserId != extractedUserId)
                {
                    await SyncService.ClearAllAsync(); // Добавим этот метод чуть позже
                }

                // 4. Сохраняем новый токен и refresh токен
                await JS.InvokeVoidAsync("localStorage.setItem", "authToken", authResponse.AccessToken);
                await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", authResponse.RefreshToken);

                // 5. Сохраняем новый UserId
                await JS.InvokeVoidAsync("localStorage.setItem", "currentUserId", extractedUserId);

                // 6. Подтягиваем свежие данные
                await SyncService.PullAllAsync();

                // ✅ Уходим на списки
                Nav.NavigateTo("/lists");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Error = error;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Error = "Ошибка соединения с сервером.";
        }
    }

}




