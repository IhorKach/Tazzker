@page "/calendar/{date:datetime}"
 @using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using System.Globalization
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject ModelMethods App
@inject SyncService SyncServ


<!-- Верхняя панель навигации -->
@* <div class="p-4 mb-4 bg-white border-b justify-between flex items-center gap-4 shadow-sm sticky top-0 z-20"> *@
<div class="p-4 mb-4 bg-yellow-50 border-b justify-between flex items-center gap-4 shadow-sm sticky top-0 z-20">
	@{
		var backLable = "< Back";
	}
	<button @onclick="GoBack"
			class="text-yellow-600  hover:text-yellow-800 font-semibold text-sm">
		@backLable
	</button>
</div>

<!-- Заголовок дня -->
<h2 class="text-2xl sm:text-3xl font-bold text-yellow-800 text-center mb-6">
	@date.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture)
</h2>

<!-- Контент -->
<div class="px-4 py-6 space-y-6">

	<!-- Задачи на день -->
	<section class="space-y-3">
		<h3 class="text-lg font-semibold text-yellow-700">📋 Today's Tasks</h3>

		@if (dayTasks.Count == 0)
		{
			<div class="text-gray-400 text-center italic">No tasks yet.</div>
		}
		else
		{
			<ul class="space-y-2">
				@foreach (var task in dayTasks)
				{
					<TaskCard TaskItem="task" OnChanged="SaveTask" />
				}
			</ul>
		}
	</section>

	<!-- кнопка добавления задачи -->
	<StickyAddButton OnClick="AddTask" />

</div>


@code {
	[Parameter] public DateTime date { get; set; }

	private List<TaskModel> dayTasks = new();

	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += Refresh;
		await Refresh();
	}

	void GoBack() => Nav.NavigateTo("/calendar");

	async Task SaveTask(TaskModel task)
	{
		await App.SaveTask(task);
		await Refresh();
	}

	async Task AddTask()
	{
		await App.AddTask(null, date);
		await Refresh();
	}

	private async Task Refresh()
	{
		var allTasks = await App.GetAllTasks();

		dayTasks = allTasks
			// .Where(t => t.DueTime?.Date == date.Date && !t.IsDeleted).OrderBy(t => t.Order).ToList();
			.Where(t => t.DueTime?.Date == date.Date && !t.PermDeleted/* IsDeleted */).OrderBy(t => t.IsCompleted).ThenByDescending(t => t.Order).ToList();
	}
}
