@* 
 @page "/calendar/{date:datetime}"
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@using System.Globalization
@inject ILocalDb<TaskModel> TaskDb
@inject NavigationManager Nav
@using Tazzker.Client.Components

<h2 class="text-2xl font-bold text-yellow-800 sticky top-0 z-20 bg-yellow-50 px-4 py-4 shadow">
    @date.ToString("dd MMMM yyyy", CultureInfo.CurrentCulture)
</h2>

<div class="px-4 py-6 space-y-4">
    <button class="text-yellow-700 hover:text-yellow-900" @onclick="GoBack">← Назад к календарю</button>

    <div class="space-y-2">
        <h3 class="text-lg font-semibold text-yellow-700">Задачи на день</h3>

        @if (dayTasks.Count == 0)
        {
            <div class="text-gray-500">Нет задач на этот день.</div>
        }
        else
        {
            <ul class="space-y-2">
                @foreach (var task in dayTasks)
                {
                    <li class="flex items-center bg-yellow-50 rounded p-2 shadow-sm">
                        <input type="checkbox"
                               @bind="task.IsCompleted"
                               @bind:after="() => SaveTask(task)"
                               class="mr-2" />

                        <span class="flex-grow cursor-pointer" @onclick="() => EditTask(task.TaskId)">
                            @task.Title
                        </span>

                        <button @onclick="() => DeleteTask(task.TaskId)"
                        @onclick:stopPropagation
                                class="ml-2 text-red-500 hover:text-red-700">
                            ✕
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mt-6">
        <h3 class="text-lg font-semibold text-yellow-700 mb-2">Добавить задачу</h3>
        <input type="text" class="border border-yellow-300 rounded px-3 py-1 w-full mb-2" placeholder="Заголовок задачи" @bind="newTaskTitle" />
        <textarea class="border border-yellow-300 rounded px-3 py-1 w-full mb-2" placeholder="Описание (необязательно)" @bind="newTaskDescription"></textarea>
        <button class="bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-1 rounded shadow w-full" @onclick="AddTask">
            ➕ Добавить задачу
        </button>
    </div>
</div>

@code {
    [Parameter] public DateTime date { get; set; }

    private List<TaskModel> dayTasks = new();
    private string newTaskTitle = string.Empty;
    private string newTaskDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var allTasks = await TaskDb.GetAllAsync();
        dayTasks = allTasks
            .Where(t => t.DueTime?.Date == date.Date && !t.IsDeleted)
            .OrderBy(t => t.Order)
            .ToList();
    }

    void GoBack()
    {
        Nav.NavigateTo("/calendar");
    }

    void EditTask(Guid taskId)
    {
        Nav.NavigateTo($"/task/{taskId}");
    }

    async Task AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskTitle))
        {
            var newTask = new TaskModel
                {
                    Title = newTaskTitle,
                    Description = newTaskDescription,
                    DueTime = date,
                    Order = dayTasks.Count + 1
                };

            await TaskDb.AddOrUpdateAsync(newTask);
            dayTasks.Add(newTask);
            newTaskTitle = string.Empty;
            newTaskDescription = string.Empty;
        }
    }

    async Task SaveTask(TaskModel task)
    {
        await TaskDb.AddOrUpdateAsync(task);
    }

    async Task DeleteTask(Guid taskId)
    {
        var task = dayTasks.FirstOrDefault(t => t.TaskId == taskId);
        if (task is not null)
        {
            task.IsDeleted = true;
            await TaskDb.AddOrUpdateAsync(task);
            dayTasks.Remove(task);
        }
    }
}
 *@
