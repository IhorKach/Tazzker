@page "/lists"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@using Tazzker.Client.Services
@inject ILocalDb<ListModel> ListDb
@inject ILocalDb<TaskModel> TaskDb
@inject ILocalDb<SublistModel> SublistDb
@inject NavigationManager Nav




<h2 class="text-2xl font-bold mb-4 text-yellow-800 sticky top-0 bg-yellow-50 py-4 z-20">
    📂 Списки
</h2>

<!-- Кнопка добавления сверху -->
<div class="flex justify-between items-center mb-6 sticky top-16 z-10 bg-yellow-50 pb-2">
    <button @onclick="AddList"
            class="bg-yellow-400 hover:bg-yellow-500 text-white px-4 py-2 rounded shadow">
        ➕ Новый список
    </button>
    <button @onclick="SyncAll"
            class="bg-yellow-100 hover:bg-yellow-200 text-yellow-800 px-4 py-2 rounded shadow">
        🔄 Синхронизировать
    </button>
    <button @onclick="SyncFromServer"
            class="bg-yellow-400 hover:bg-yellow-500 text-white px-4 py-2 rounded shadow">
        🔄 Обновить из сервера
    </button>
</div>

@if (lists.Count == 0)
{
    <div class="text-center text-gray-400 italic mt-8">У вас пока нет списков 🐝</div>
}
else
{
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
        @foreach (var list in lists)
        {
            <div @onclick="@(() => Nav.NavigateTo($"/list/{list.Id}"))"
                 class="bg-yellow-100 hover:bg-yellow-200 p-4 rounded-xl shadow cursor-pointer transition-all group">
                <div class="text-lg font-semibold text-gray-800 truncate mb-1">@list.Title</div>
                <div class="text-sm text-gray-600">
                    🕒 @list.UpdatedAt.ToLocalTime().ToString("g")
                </div>
                <div class="text-sm text-gray-500">
                    ✅ Задач: @GetTaskCount(list.Id)
                </div>
            </div>
        }
    </div>
}

<!-- FAB-кнопка на мобилках -->
<button @onclick="AddList"
        class="sm:hidden fixed bottom-4 right-4 bg-yellow-400 hover:bg-yellow-500 text-white text-xl rounded-full w-14 h-14 shadow-lg flex items-center justify-center z-50">
    +
</button>

@code {
    List<ListModel> lists = new();
    List<TaskModel> tasks = new();
    List<SublistModel> sublists = new();
    Dictionary<Guid, List<Guid>> sublistsByList = new();

    protected override async Task OnInitializedAsync()
    {
        lists = await ListDb.GetAllAsync();
        tasks = await TaskDb.GetAllAsync();
        sublists = await SublistDb.GetAllAsync();

        sublistsByList = sublists
            .GroupBy(s => s.ListId)
            .ToDictionary(g => g.Key, g => g.Select(s => s.Id).ToList());
    }

    int GetTaskCount(Guid listId)
    {
        if (!sublistsByList.TryGetValue(listId, out var sublistIds))
            return 0;

        return tasks.Count(t => t.SublistId.HasValue && sublistIds.Contains(t.SublistId.Value));
    }

    async Task AddList()
    {
        var list = new ListModel
            {
                Id = Guid.NewGuid(),
                Title = "Новый список",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

        await ListDb.AddOrUpdateAsync(list);
        lists = await ListDb.GetAllAsync();
    }

    [Inject] private SyncService Sync { get; set; }

    private async Task SyncAll()
    {
        await Sync.SyncAllAsync();
        await Sync.SyncHardDeletedAsync();
        Console.WriteLine("Синхронизация завершена.");
    }

    private async Task SyncFromServer()
    {
        await Sync.PullAllAsync();
        // При желании — перезагрузи текущую страницу:
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

}