@page "/lists"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@using Tazzker.Client.Services
@inject NavigationManager Nav
@inject ModelMethods App
@inject SyncService SyncServ


 @* <h2 class="text-2xl font-bold mb-4 text-yellow-800 sticky top-0 bg-yellow-50 py-4 z-20"> *@
<h2 class="text-3xl font-bold text-yellow-800 sticky top-0 z-20 bg-yellow-50 px-4 py-4 shadow mb-4">
	📂 Lists
</h2>


@if (lists.Count == 0)
{
	<div class="text-center text-gray-400 italic mt-8">No lists yet.</div>
}
else
{
	<div class="grid gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
		@foreach (var list in lists)
		{
			<ListCard OnClick="Redirect" TasksAmount="@GetTaskCount(list.Id)" ListItem="list" OnDelete="SetListToDelete" LastUpdate="@GetLastUpdate(list.Id)"></ListCard>
		}
	</div>
}


<ConfirmDialog Message="Delete the list and all its contents?"
			   Show="@showConfirmModal"
			   OnConfirm="HandleConfirmDelete" />

<StickyAddButton OnClick="AddList"></StickyAddButton>

@code {
	List<ListModel> lists = new();
	List<TaskModel> tasks = new();
	List<SublistModel> sublists = new();
	Dictionary<Guid, List<Guid>> sublistsByList = new();

	private bool showConfirmModal = false;
	private Guid? listToDelete = null;

	private void SetListToDelete(Guid listId)
	{
		listToDelete = listId;
		showConfirmModal = true;
	}

	private async Task HandleConfirmDelete(bool confirmed)
	{
		showConfirmModal = false;
		if (!confirmed || listToDelete is null) return;

		await DeleteList((Guid)listToDelete);
		listToDelete = null;
		showConfirmModal = false;
	}

	private async Task Refresh()
	{
		lists = await App.GetAllLists();
		tasks = await App.GetAllTasks();
		sublists = await App.GetAllSublists();

		sublistsByList = sublists
			.GroupBy(s => s.ListId)
			.ToDictionary(g => g.Key, g => g.Select(s => s.Id).ToList());
	}



	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += Refresh;
		await Refresh();
	}

	private int GetTaskCount(Guid listId)
	{
		if (!sublistsByList.TryGetValue(listId, out var sublistIds))
			return 0;

		return tasks.Count(t => t.SublistId.HasValue && sublistIds.Contains(t.SublistId.Value));
	}

	private DateTime GetLastUpdate(Guid listId)
	{
		var list = lists.FirstOrDefault(l => l.Id == listId);
		if (list == null) return DateTime.MinValue;

		var listUpdated = list.UpdatedAt;

		var sublistIds = sublists
			.Where(s => s.ListId == listId)
			.Select(s => s.Id)
			.ToList();

		var sublistUpdated = sublists
			.Where(s => s.ListId == listId)
			.Select(s => s.UpdatedAt);

		var taskUpdated = tasks
			.Where(t => t.SublistId.HasValue && sublistIds.Contains(t.SublistId.Value))
			.Select(t => t.UpdatedAt);

		return new[] { listUpdated }
			.Concat(sublistUpdated)
			.Concat(taskUpdated)
			.Max();
	}


	private async Task AddList()
	{
		var listId = await App.AddList();

		Redirect(listId);
	}

	private async Task DeleteList(Guid listId)
	{
		// 1. Получаем все подсписки, связанные с этим списком
		if (!sublistsByList.TryGetValue(listId, out var sublistIds))
			sublistIds = new();

		// 2. Находим все задачи, привязанные к этим подспискам
		var tasksToDelete = tasks
			.Where(t => t.SublistId.HasValue && sublistIds.Contains(t.SublistId.Value))
			.ToList();

		foreach (var task in tasksToDelete)
		{
			await App.DeleteTask(task.Id);
		}

		// 3. Удаляем все подсписки
		foreach (var subId in sublistIds)
		{
			await App.DeleteSublist(subId);
		}

		// 4. Удаляем сам список
		await App.DeleteList(listId);

		// 5. Обновляем состояние (чтобы список исчез из UI)
		lists.RemoveAll(l => l.Id == listId);
		sublists.RemoveAll(s => s.ListId == listId);
		tasks.RemoveAll(t => t.SublistId.HasValue && sublistIds.Contains(t.SublistId.Value));
		sublistsByList.Remove(listId);
	}


	private void Redirect(Guid listId) => Nav.NavigateTo($"/list/{listId}");
}