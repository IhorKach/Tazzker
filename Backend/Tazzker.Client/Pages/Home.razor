@page "/"
@using System.Globalization
@inject NavigationManager Nav

<div class="px-6 py-10 max-w-2xl mx-auto text-center">
    <h1 class="text-3xl font-bold text-yellow-800 mb-3">🐝 Welcome!</h1>
    <p class="text-yellow-900 text-lg">Today: @DateTime.Now.ToString("D", CultureInfo.CurrentCulture)</p>
    @{var url = "/inbox";}
    <button class="mt-6 inline-flex items-center gap-2 text-yellow-800 hover:text-yellow-900 font-medium text-base underline underline-offset-4 transition-all"
            @onclick="() => Nav.NavigateTo(url)">
        ➡ Go to tasks
    </button>
</div>
