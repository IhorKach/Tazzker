@page "/test"

<div class="min-h-screen bg-gray-100 p-8">
    <h2 class="text-2xl font-bold mb-6">Тест ✕</h2>

    <div class="relative group max-w-md bg-yellow-100 hover:bg-yellow-200 p-4 rounded-xl shadow cursor-pointer transition-all">
        <!-- Кнопка ✕ -->
        <button class="absolute top-2 right-2 text-red-500 hover:text-red-700 font-bold text-xl opacity-0 group-hover:opacity-100 transition z-10"
                title="Удалить"
        @onclick:stopPropagation>
            ✕
        </button>

        <!-- Контент -->
        <div class="font-semibold text-lg mb-1 text-gray-800 truncate">Заметка</div>
        <div class="text-sm text-gray-600 line-clamp-3">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</div>
    </div>
</div>

<div class="p-6">
    <div class="grid grid-cols-7 gap-2">
        @for (int i = 1; i <= 28; i++)
        {
            <div class="aspect-square bg-yellow-100 rounded-lg text-center font-bold text-yellow-900 flex items-center justify-center">
                @i
            </div>
        }
    </div>
</div>

