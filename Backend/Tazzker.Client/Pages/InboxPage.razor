@page "/inbox"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@inject ILocalDb<TaskModel> TaskDb
@using Tazzker.Client.Services
@inject ModelMethods App
@inject SyncService SyncServ

<div class="min-h-screen flex flex-col">


	<h2 class="text-2xl font-bold mb-4 text-yellow-800 sticky top-0 bg-yellow-50 py-4 z-20">
		📥 Инбокс
	</h2>

	<!-- Контент -->
	<main class="px-4 py-6 space-y-6">
		@if (tasks.Count == 0)
		{
			<div class="text-gray-500 italic mt-6">Нет задач в инбоксе 🐝</div>
		}
		else
		{
			<div class="space-y-4">
				@foreach (var task in tasks)
				{
					<TaskCard TaskItem="task" OnChanged="SaveTask" />
				}
			</div>
		}
	</main>

<StickyAddButton OnClick="AddTask"></StickyAddButton>
</div>



@code {
	List<TaskModel> tasks = new();

	protected override async Task OnInitializedAsync()
	{
		SyncServ.OnSynced += Refresh;
		await Refresh();
	}

	private async Task AddTask()
	{
		await App.AddTask();
		await Refresh();
	}


	private async Task Refresh()
	{
		var allTasks = await App.GetAllTasks();
		// tasks = allTasks.Where(t => t.SublistId == null && !t.IsDeleted).OrderByDescending(t => t.UpdatedAt).ToList();
		tasks = allTasks.Where(t => t.SublistId == null && !t.IsDeleted).OrderBy(t=>t.IsCompleted).ThenByDescending(t => t.Order).ToList();
	}


	private async Task SaveTask(TaskModel task)
	{
		await App.SaveTask(task);

		await Refresh();
	}

}
