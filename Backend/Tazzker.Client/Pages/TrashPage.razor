@page "/trash"
@using Tazzker.Client.Components
@using Tazzker.Client.Data.Models
@using Tazzker.Client.Interfaces
@inject ILocalDb<TaskModel> TaskDb
@inject ILocalDb<NoteModel> NoteDb



<!--current good version-->
<h2 class="text-3xl font-bold text-yellow-800 sticky top-0 z-20 bg-yellow-50 px-4 py-4 shadow">
	🗑 Корзина
</h2>

<div class="px-4 py-6 space-y-10 max-w-screen-md mx-auto">

	<!-- Задачи -->
	<section class="space-y-4">
		<div class="text-xl font-semibold text-yellow-700 border-b border-yellow-300 pb-1 px-4 mt-10">
			📝 Задачи
		</div>

		@if (trashTasks.Count == 0)
		{
			<div class="text-gray-500 italic">Нет удалённых задач</div>
		}
		else
		{
			@foreach (var task in trashTasks)
			{
				<div class="bg-white border border-yellow-200 rounded-xl p-4 shadow flex justify-between items-start gap-4">
					<div style="word-break: break-word; overflow-wrap: anywhere;"
						 class="text-gray-800 font-medium w-full whitespace-pre-wrap">
						@task.Title
					</div>
					<div class="flex gap-2">
						<button @onclick="() => RestoreTask(task.Id)"
								class="w-9 h-9 flex items-center justify-center bg-green-100 text-green-700 rounded-full hover:bg-green-200 transition"
								title="Восстановить">
							♻️
						</button>
						<button @onclick="() => DeleteTask(task.Id)"
								class="w-9 h-9 flex items-center justify-center bg-red-100 text-red-700 rounded-full hover:bg-red-200 transition"
								title="Удалить навсегда">
							🗑
						</button>
					</div>
				</div>
			}
		}
	</section>

	<!-- Заметки -->
	<section class="space-y-4">
		<div class="text-xl font-semibold text-yellow-700 border-b border-yellow-300 pb-1 px-4 mt-8">
			📒 Заметки
		</div>

		@if (trashNotes.Count == 0)
		{
			<div class="text-gray-500 italic">Нет удалённых заметок</div>
		}
		else
		{
			@foreach (var note in trashNotes)
			{
				<div class="bg-white border border-yellow-200 rounded-xl p-4 shadow flex justify-between items-start gap-4">
					<div style="word-break: break-word; overflow-wrap: anywhere;"
						 class="text-gray-800 font-medium w-full whitespace-pre-wrap">
						@note.Title
					</div>
					<div class="flex gap-2">
						<button @onclick="() => RestoreNote(note.Id)"
								class="w-9 h-9 flex items-center justify-center bg-green-100 text-green-700 rounded-full hover:bg-green-200 transition"
								title="Восстановить">
							♻️
						</button>
						<button @onclick="() => DeleteNote(note.Id)"
								class="w-9 h-9 flex items-center justify-center bg-red-100 text-red-700 rounded-full hover:bg-red-200 transition"
								title="Удалить навсегда">
							🗑
						</button>
					</div>
				</div>
			}
		}
	</section>
</div>




@code {
	List<TaskModel> trashTasks = new();
	List<NoteModel> trashNotes = new();

	protected override async Task OnInitializedAsync()
	{
		trashTasks = (await TaskDb.GetAllRawAsync()).Where(t => t.IsDeleted && !t.PermDeleted).ToList();
		trashNotes = (await NoteDb.GetAllRawAsync()).Where(t => t.IsDeleted && !t.PermDeleted).ToList();
	}

	async Task RestoreTask(Guid id) => await Restore(trashTasks, id, TaskDb);
	async Task DeleteTask(Guid id) => await HardDelete(trashTasks, id, TaskDb);

	async Task RestoreNote(Guid id) => await Restore(trashNotes, id, NoteDb);
	async Task DeleteNote(Guid id) => await HardDelete(trashNotes, id, NoteDb);

	async Task Restore<T>(List<T> list, Guid id, ILocalDb<T> db) where T : ISyncable
	{
		var item = list.FirstOrDefault(x => x.Id == id);
		if (item is null) return;

		item.IsDeleted = false;
		item.IsSynced = false;
		await db.AddOrUpdateAsync(item);
		list.Remove(item);
	}

	async Task HardDelete<T>(List<T> list, Guid id, ILocalDb<T> db) where T : ISyncable
	{
		var item = list.FirstOrDefault(x => x.Id == id);
		if (item is null) return;

		item.PermDeleted = true;
		item.IsSynced = false;
		await db.AddOrUpdateAsync(item);
		list.Remove(item);
	}
}