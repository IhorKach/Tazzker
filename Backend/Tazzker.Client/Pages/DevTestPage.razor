@page "/devtest"
@using Tazzker.Client.Services;
@inject IndexedDbBridge Db

<h3>IndexedDB Native Bridge</h3>

<button @onclick="Init">Инициализировать</button>
<button @onclick="Add">Добавить задачу</button>
<button @onclick="Load">Загрузить</button>
<button @onclick="Clear">Очистить</button>

<ul>
    @foreach (var task in tasks)
    {
        <li>@task.Title</li>
    }
</ul>

@code {
    List<TaskModel> tasks = new();

    async Task Init() => await Db.InitAsync();

    async Task Add()
    {
        var task = new TaskModel
            {
                Id = Guid.NewGuid().ToString(),
                Title = "Новая задача " + DateTime.Now.Ticks
            };

        await Db.AddAsync("Tasks", task);
    }

    async Task Load()
    {
        tasks = await Db.GetAllAsync<TaskModel>("Tasks");
    }

    async Task Clear()
    {
        await Db.ClearAsync("Tasks");
        tasks.Clear();
    }

    public class TaskModel
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
    }
}
