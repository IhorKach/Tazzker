@layout NoteLayout
@using Tazzker.Client.Data.LocalDb;
@using Tazzker.Client.Data.Models;
@using Tazzker.Client.Interfaces;

@page "/note/{Id:guid}"
@using Tazzker.Client.Components
@inject NavigationManager Nav
@inject ILocalDb<NoteModel> NoteDb
@inject IJSRuntime JS

@* absolute inset-0 *@
<div class="min-h-screen flex flex-col bg-yellow-50">
	@{
		var backLabel = "< Back";
	}
	<!-- Navigation -->
	<div class="p-4 bg-yellow-50 border-b justify-between flex items-center gap-4 shadow-sm">
		<button @onclick="GoBack" class="text-yellow-600  hover:text-yellow-800 font-semibold text-sm"> @backLabel</button>
		<span class="text-xs text-gray-400 italic"> Last updated: @note.UpdatedAt.ToLocalTime().ToString("g")</span>

	</div>

	<!-- Контент -->
	<div class="flex-1 overflow-auto px-4 py-6 flex flex-col gap-6 max-w-screen-md w-full mx-auto">

		<!-- Title -->

		<textarea maxlength="@TitleMaxLength"
				  class="min-h-[60vh] whitespace-pre-wrap w-full bg-white border border-yellow-300 rounded-xl p-4 text-gray-800 shadow focus:outline-none focus:ring-2 focus:ring-yellow-500 leading-relaxed resize-none overflow-hidden"
				  rows="1"
				  value="@note.Title"
				  @oninput="HandleTitleInput"
				  @onblur="() => SaveNote()">
		</textarea>

		<div class="text-sm text-gray-500 text-right">
			@note.Title.Length / @TitleMaxLength
		</div>


		<!-- Body -->
		
<textarea maxlength="@BodyMaxLength"
		  class=" whitespace-pre-wrap w-full bg-white border border-yellow-300 rounded-xl p-4 text-gray-800 shadow focus:outline-none focus:ring-2 focus:ring-yellow-500 leading-relaxed resize-none overflow-hidden"
		  rows="1"
		  value="@note.Body"
		  @oninput="HandleBodyInput"
		  @onblur="() => SaveNote()">
</textarea>

		<div class="text-sm text-gray-500 text-right">
			 @note.Body.Length / @BodyMaxLength
		</div>

	</div>
</div>





@using Tazzker.Client.Services
@inject ModelMethods App

@code {
	[Parameter] public Guid Id { get; set; }
	private NoteModel note = new();

	private int GetBodyLength() => note.Body.Count();
	private int GetTitleLength() => note.Title.Count();

	private int BodyMaxLength = 4096;
	private int TitleMaxLength = 128;

	private async Task HandleTitleInput(ChangeEventArgs e)
	{
		note.Title = e.Value?.ToString() ?? "";
		await JS.InvokeVoidAsync("resizeTextareas");
	}
	private async Task HandleBodyInput(ChangeEventArgs e)
	{
		note.Body = e.Value?.ToString() ?? "";
		await JS.InvokeVoidAsync("resizeTextareas");
	}


	protected override async Task OnInitializedAsync()
	{
		var found = await App.GetNoteById(Id);

		note = found ?? new NoteModel { Id = Id, Title = "", Body = "" };

		StateHasChanged();

		await Task.Yield();
		await JS.InvokeVoidAsync("resizeTextareas");
	}

	private void GoBack() => Nav.NavigateTo("/notes");

	private async Task SaveNote() => await App.SaveNote(note);

	private async Task Resize(ChangeEventArgs _)
	{
		await JS.InvokeVoidAsync("resizeTextareas");
	}
}

