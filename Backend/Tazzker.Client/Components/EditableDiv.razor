@* Компонент: EditableDiv.razor *@
@*not actual *@ 
@* needs customization and work on it *@ 
@inject IJSRuntime JS

<div @ref="ElementRef"
     contenteditable="true"
     class="@Class"
     @oninput="OnInput"
     @onblur="OnBlur"
     data-editable-id="@_uid">
</div>

@if (ShowCounter)
{
    <div class="text-sm text-gray-500 text-right">
        @_currentLength / @MaxLength
    </div>
}

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int MaxLength { get; set; } = 512;
    [Parameter] public bool ShowCounter { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    private ElementReference ElementRef;
    private string _uid = $"editable-{Guid.NewGuid()}";
    private int _currentLength = 0;
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _initialized = true;
            var selector = $"[data-editable-id='{_uid}']";
            await JS.InvokeVoidAsync("noteInterop.setContent", selector, Value);
            _currentLength = Value.Length;
            StateHasChanged();
        }
    }

    private async Task OnInput(ChangeEventArgs _)
    {
        var selector = $"[data-editable-id='{_uid}']";
        var text = await JS.InvokeAsync<string>("noteInterop.getContent", selector);

        if (text.Length > MaxLength)
        {
            // обрезаем последний ввод
            await JS.InvokeVoidAsync("noteInterop.preventLastInput", ElementRef);
            text = text.Substring(0, MaxLength);
        }

        _currentLength = text.Length;

        if (Value != text)
        {
            Value = text;
            await ValueChanged.InvokeAsync(text);
        }
    }

    private async Task OnBlur(FocusEventArgs _)
    {
        var selector = $"[data-editable-id='{_uid}']";
        var text = await JS.InvokeAsync<string>("noteInterop.getContent", selector);
        text = text.Trim();

        if (Value != text)
        {
            Value = text;
            await ValueChanged.InvokeAsync(text);
        }
    }
}
