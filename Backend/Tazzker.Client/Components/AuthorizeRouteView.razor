@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Tazzker.Client.Services
@inject IndexedDbBridge Db

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (isAuthorized)
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        }
        else
        {
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Проверка авторизации...</p>
            </LayoutView>
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>Страница не найдена.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private bool isAuthorized = false;

    private readonly string[] PublicRoutes = new[]
    {
        "",           
        "auth"
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await CheckAuthorizationAsync();
        await EnsureDbInitializedAsync();
    }

    private async Task EnsureDbInitializedAsync()
    {
        var hasStores = await Db.HasAnyStoresAsync();
        if (!hasStores)
            await Db.InitAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckAuthorizationAsync();
    }

    private async Task CheckAuthorizationAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant().TrimEnd('/');

        if (IsPublicRoute(path))
        {
            isAuthorized = true;
            StateHasChanged();
            return;
        }

        var isLoggedIn = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");

        isAuthorized = isLoggedIn == "true";

        if (!isAuthorized && !IsPublicRoute(path))
        {
            Nav.NavigateTo("/auth");
        }

        StateHasChanged();
    }

    private bool IsPublicRoute(string path)
    {
        return PublicRoutes.Any(p => path == p || path.StartsWith(p + "/"));
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
