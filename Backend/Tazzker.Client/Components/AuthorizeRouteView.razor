@*  // last worked version
 @inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Tazzker.Client.Services
@inject IndexedDbBridge Db

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (isAuthorized)
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        }
        else
        {
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Проверка авторизации...</p>
            </LayoutView>
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>Страница не найдена.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private bool isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await CheckAuthorizationAsync();
        await EnsureDbInitializedAsync();
    }

    private async Task EnsureDbInitializedAsync()
    {
        var hasStores = await Db.HasAnyStoresAsync();
        if (!hasStores)
            await Db.InitAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckAuthorizationAsync();
    }

    private async Task CheckAuthorizationAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();

        // Разрешаем доступ к логин/регистрации
        if (path.StartsWith("auth") || path.StartsWith("login"))
        {
            isAuthorized = true;
            StateHasChanged();
            return;
        }

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, "/api/auth/userid");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                isAuthorized = true;
                StateHasChanged();
            }
            else
            {
                HandleUnauthorized(path);
            }
        }
        catch
        {
            HandleUnauthorized(path);
        }
    }

    private void HandleUnauthorized(string path)
    {
        isAuthorized = false;

        // 🚫 Чтобы не делать редирект, если ты и так уже на /auth
        if (!path.StartsWith("auth") && !path.StartsWith("login"))
        {
            Nav.NavigateTo("/auth", forceLoad: true);
        }
    }



    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
