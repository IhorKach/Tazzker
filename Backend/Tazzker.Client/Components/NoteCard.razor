@using Tazzker.Client.Data.Models;
@inject IJSRuntime JS

@if (NoteItem != null)
{
	<div class="bg-white rounded-xl p-4 shadow border border-yellow-300 hover:shadow-md transition cursor-pointer"
		 @onclick="() => OnClick.InvokeAsync(NoteItem.Id)">

		<!-- Title + Delete Button -->
		<div class="flex justify-between items-start mb-2"
			 style="word-break: break-word; overflow-wrap: anywhere;">
			<h3 class="text-lg font-semibold text-yellow-800 break-words mr-2">@NoteItem.Title</h3>
			<button class="text-red-500 hover:text-red-700 font-bold px-1"
			@onclick:stopPropagation
					@onclick="() => OnDelete.InvokeAsync(NoteItem.Id)">
				Х
			</button>
		</div>

		<div class="flex justify-between text-xs text-gray-500 italic">
			<span>Обновлено: @NoteItem.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
		</div>
	</div>
}

@code {
	[Parameter] public NoteModel? NoteItem { get; set; }
	[Parameter] public EventCallback<Guid> OnClick { get; set; }
	[Parameter] public EventCallback<Guid> OnDelete { get; set; }
}
