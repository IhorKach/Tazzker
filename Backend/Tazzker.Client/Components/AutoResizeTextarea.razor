@inject IJSRuntime JS

<textarea @bind="Text"
          @ref="textareaRef"
          class="@Class"
          rows="1"
          maxlength="@MaxLength"
          @oninput="Resize"
          @onblur="OnBlur"
          placeholder="@Placeholder">
</textarea>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public EventCallback OnBlurCallback { get; set; }
    [Parameter] public string Class { get; set; } = "auto-resize";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public int MaxLength { get; set; } = 4096;

    private ElementReference textareaRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("resizeSingleTextarea", textareaRef);
        }
    }

    private async Task Resize(ChangeEventArgs _)
    {
        await JS.InvokeVoidAsync("resizeSingleTextarea", textareaRef);
        await TextChanged.InvokeAsync(Text);
    }

    private async Task Resize2()
    {
        await JS.InvokeVoidAsync("resizeSingleTextarea", textareaRef);
    }
    private async Task OnBlur(FocusEventArgs _)
    {
        await OnBlurCallback.InvokeAsync();
    }
}
