@using Tazzker.Client.Services
@inject SyncService SyncService
@inject SyncStatusService SyncStatus
@implements IDisposable

@code {
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        SyncStatus.Status = SyncState.Idle; // Явно говорим что ещё ничего не синкалось

        // Подождать чуть-чуть, чтобы пользователь увидел дефолтное состояние
        await Task.Delay(500);

        await TrySync();

        _timer = new Timer(async _ => await TrySync(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }


    private async Task TrySync()
    {
        try
        {
            SyncStatus.Status = SyncState.Syncing;

            await SyncService.SyncAllAsync();
            await SyncService.SyncHardDeletedAsync();
            await SyncService.PullAllAsync();

            SyncStatus.Status = SyncState.Synced;

            // Подождать чуть-чуть, показать галочку ✅
            await Task.Delay(1000);

            SyncStatus.Status = SyncState.Idle;
        }
        catch (Exception ex)
        {
            SyncStatus.Status = SyncState.Error;
            Console.WriteLine($"Sync failed: {ex.Message}");

            // Ошибку чуть дольше показываем
            await Task.Delay(3000);
            SyncStatus.Status = SyncState.Idle;
        }
    }




    public void Dispose()
    {
        _timer?.Dispose();
    }
}
