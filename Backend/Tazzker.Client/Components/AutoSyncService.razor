@using Tazzker.Client.Services
@inject SyncService SyncService
@inject SyncStatusService SyncStatus
@inject IJSRuntime JS
@implements IDisposable

@code {
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        SyncStatus.Status = SyncState.Idle;

        // await Task.Delay(500);
        await TrySync();

        _timer = new Timer(async _ => await TrySync(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private async Task TrySync()
    {
        var isOnline = await JS.InvokeAsync<bool>("isOnline");
        if (!isOnline)
        {
            Console.WriteLine("No internet - no sync.");
            return;
        }

        var isLoggedIn = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");
        if (isLoggedIn != "true")
        {
            Console.WriteLine("user logged out - sync cancelled.");
            return;
        }

        try
        {
            SyncStatus.Status = SyncState.Syncing;
            await SyncService.TrySyncEverythingAsync();
            SyncStatus.Status = SyncState.Synced;
            await Task.Delay(1000);
        }
        catch (Exception ex)
        {
            SyncStatus.Status = SyncState.Error;
            Console.WriteLine($" Sync failed: {ex.Message}");
            await Task.Delay(3000);
        }
        finally
        {
            SyncStatus.Status = SyncState.Idle;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}